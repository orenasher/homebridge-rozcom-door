{
  "pluginAlias": "RozcomDoor",
  "pluginType": "platform",
  "singular": true,
  "headerDisplay": "Open your building entrance door from Apple Home. Add one door per Rozcom intercom door. / פתיחת דלת הכניסה של הבניין מאפליקציית הבית. מוסיפים דלת לכל דלת אינטרקום של Rozcom.",
  "schema": {
    "type": "object",
    "properties": {
      "name": {
        "title": "Name",
        "type": "string",
        "default": "Rozcom Door"
      },
      "doors": {
        "title": "Doors",
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "name": {
              "title": "Name in Apple Home",
              "type": "string",
              "default": "Front Door"
            },
            "mqttHost": {
              "title": "MQTT Broker Host",
              "type": "string",
              "default": "62.219.14.161"
            },
            "mqttPort": {
              "title": "MQTT Broker Port",
              "type": "integer",
              "default": 1883
            },
            "topic": {
              "title": "MQTT Topic",
              "type": "string",
              "placeholder": "Intercom/BUILDING_ID/startcall"
            },
            "payload": {
              "title": "MQTT Payload",
              "type": "string",
              "placeholder": "openDoor1:CODE"
            },
            "unlockSeconds": {
              "title": "Unlock time in seconds / זמן פתיחה בשניות",
              "type": "integer",
              "default": 2,
              "minimum": 1,
              "maximum": 30,
              "description": "How long the lock shows unlocked before returning to locked. / כמה זמן המנעול מוצג כפתוח לפני שהוא חוזר לנעול."
            }
          },
          "required": [
            "name",
            "topic",
            "payload"
          ]
        }
      }
    },
    "required": [
      "name"
    ]
  }
}
